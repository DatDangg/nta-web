# Biến môi trường runtime của nta-web (CR-031). Giá trị dưới là GIẢ — giá trị thật đặt ở .env.local / GitHub Secrets.

# PostgreSQL (container nta-db). Web + script tools/db dùng DATABASE_URL; `next build` KHÔNG cần.
DATABASE_URL=postgres://nta:change-me@localhost:5432/nta_web
# Mật khẩu user Postgres cho container nta-db (docker-compose).
POSTGRES_PASSWORD=change-me

# Secret cho POST /api/revalidate (xoá cache sau khi nội dung trong DB đổi).
REVALIDATE_SECRET=change-me-long-random-string
# Chỉ cho CLI `npm run db:cli -- revalidate` (không phải env của web).
REVALIDATE_URL=http://127.0.0.1:3005/api/revalidate
